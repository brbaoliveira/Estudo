<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Organize" parent="Base.Theme.Organize">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="android:textColorPrimary">@color/gray</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>
    <style name="despesaTheme" parent="Theme.AppCompat.Light">
        <item name="colorPrimary">@color/colorPrimary2</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark2</item>
        <item name="colorAccent">@color/colorAccent2</item>
    </style>
    <style name="receitaTheme" parent="Theme.AppCompat.Light">
        <item name="colorPrimary">@color/colorPrimary1</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark1</item>
        <item name="colorAccent">@color/colorAccent1</item>
    </style>
</resources>